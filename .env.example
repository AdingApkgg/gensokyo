# 本地开发依赖跑原生进程（不用容器）：./scripts/dev-services.sh up
# postgres / redis 是 brew 的共享实例，gensokyo 用独立的库；Meilisearch 是专属实例
DATABASE_URL=postgres://gensokyo:gensokyo@localhost:5432/gensokyo
REDIS_URL=redis://localhost:6379/1
MEILI_HOST=http://localhost:57700
MEILI_MASTER_KEY=dev_master_key

# openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# 自建 MinIO：只存封面等小图，大型资源走外链镜像
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=gensokyo
S3_SECRET_ACCESS_KEY=gensokyo-dev-secret
S3_BUCKET=gensokyo
S3_PUBLIC_BASE_URL=http://127.0.0.1:59000/gensokyo

# 逗号分隔；生产改成真实域名（如 https://th.saop.cc）
TRUSTED_ORIGINS=http://localhost:3000

# 邮件：不配 MAIL_TRANSPORT 时默认 console（打印到 stdout，dev 与测试用，
# bun run e2e 的注册链路靠这个读验证码），本地不需要配置。生产按需切到
# resend 或 smtp，变量定义见 apps/api/src/mail/config.ts 的 parseMailEnv。
#
# ⚠️ 这三组变量要么**整行不写**，要么写成非空值。写成空串（`MAIL_TRANSPORT=`）
# 会让进程启动就抛 zod 错误——`?? 'console'` 只接 undefined，接不住空串。
# 这是刻意的（配错比静默不发信好），但别被它绊到。
#
# Resend（HTTP API，零依赖）：
# MAIL_TRANSPORT=resend
# MAIL_FROM=幻想乡 <noreply@th.saop.cc>   # 必须是 Resend 里已验证的域名
# RESEND_API_KEY=re_xxxxxxxxxxxx
#
# 通用 SMTP（换国内服务商时只改这一组，不动代码）：
# MAIL_TRANSPORT=smtp
# MAIL_FROM=幻想乡 <noreply@th.saop.cc>
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx
# SMTP_SECURE=true                        # 同样不能是空串

# Google 登录：两个都配齐才注册这个 provider（不配就只是不显示按钮，不报错）。
# Google Cloud Console 里的「已获授权的重定向 URI」必须**逐字**填成下面这个，
# 端口是 **3000 不是 3001**——BETTER_AUTH_URL 指向 web 的 origin，vite 再把
# /api 代理到 3001。生产填 https://th.saop.cc/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# 注：SEO 用的 SITE_URL **不在这里**。这份 .env 是 api 与脚本的（web 的 dev
# server 读的是 Vite 自己的 env），而生产由 deploy/compose.yml 从 PUBLIC_URL
# 派生，不单独配一个会漂移的第二份基址。本地不配，回落请求 origin 即正确。
