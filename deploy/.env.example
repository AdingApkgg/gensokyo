# 生产环境变量。**复制成 deploy/.env 后填真值，那份不进 git。**
#
#   cp deploy/.env.example deploy/.env
#   # 三个密钥各生成一次：
#   openssl rand -base64 32

# 对外地址。它同时是 better-auth 的 baseURL、trustedOrigins 与图片基地址——
# 填错了登录会因为 CSRF 校验失败而整个不能用。
# 内网预览填 http://<ip>:<port>，正式域名填 https://th.saop.cc
PUBLIC_URL=http://192.168.9.29:3800

# Caddy 监听的站点地址。内网预览用 :80（明文），
# 正式域名直接写域名（Caddy 会自动申请证书，那时 HTTP_PORT 要改成 80/443）
SITE_ADDRESS=:80
HTTP_PORT=3800

# --- 密钥：每个环境各生成一次，别复用开发值 ---
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
MEILI_MASTER_KEY=
MINIO_ROOT_USER=gensokyo
MINIO_ROOT_PASSWORD=

S3_BUCKET=gensokyo
