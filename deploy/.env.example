# 生产环境变量。**复制成 deploy/.env 后填真值，那份不进 git。**
#
#   cp deploy/.env.example deploy/.env
#   # 三个密钥各生成一次：
#   openssl rand -base64 32

# 对外地址。它同时是 better-auth 的 baseURL、trustedOrigins 与图片基地址——
# 填错了登录会因为 CSRF 校验失败而整个不能用。
# 内网预览填 http://<ip>:<port>，正式域名填 https://th.saop.cc
PUBLIC_URL=http://192.168.9.29:3800

# Caddy 监听的站点地址。内网预览用 :80（明文），
# 正式域名直接写域名（Caddy 会自动申请证书，那时 HTTP_PORT 要改成 80/443）
SITE_ADDRESS=:80
HTTP_PORT=3800

# --- 密钥：每个环境各生成一次，别复用开发值 ---
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
MEILI_MASTER_KEY=
MINIO_ROOT_USER=gensokyo
MINIO_ROOT_PASSWORD=

S3_BUCKET=gensokyo

# 反代后面 action 的 CSRF 放行域名（只填主机名，不含协议）。
# 与 PUBLIC_URL 的 host 部分一致，例如 th.saop.cc
PUBLIC_HOST=th.saop.cc

# --- 邮件：三选一，MAIL_TRANSPORT 不填默认 console——**生产上等于一封信
# 都发不出去**，所有验证码只会打进容器日志，且日志看起来一切正常。
# 上线检查表「实际注册一个账号、收一封真信」这一步就是专门防这个 ---
MAIL_TRANSPORT=resend
MAIL_FROM=
# transport=resend 时必填
RESEND_API_KEY=
# transport=smtp 时必填（国内邮箱送达率不行就是靠切到这个通道兜底）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Google 登录：可选，两个都留空则登录按钮不出现（不报错，静默降级，
# 见 apps/api/src/auth.ts 的 googleConfigured()）。填了就要同步去 Google
# Cloud Console 给这个 OAuth 客户端登记授权重定向 URI：
# ${PUBLIC_URL}/api/auth/callback/google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
