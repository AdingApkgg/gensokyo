{
  "name": "@gensokyo/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --env-file=../../.env",
    "generate": "drizzle-kit generate",
    "migrate": "bun run --env-file=../../.env scripts/migrate.ts",
    "seed": "bun run --env-file=../../.env scripts/seed.ts",
    "seed:demo": "bun run --env-file=../../.env scripts/seed-demo.ts",
    "seed:demo-tools": "bun run --env-file=../../.env scripts/seed-demo-tools.ts",
    "seed:demo-fanworks": "bun run --env-file=../../.env scripts/seed-demo-fanworks.ts",
    "seed:demo-official": "bun run --env-file=../../.env scripts/seed-demo-official.ts",
    "seed:demo-lilywhite": "bun run --env-file=../../.env scripts/seed-demo-lilywhite.ts",
    "seed:demo-official-free": "bun run --env-file=../../.env scripts/seed-demo-official-free.ts"
  },
  "dependencies": {
    "@gensokyo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@gensokyo/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2"
  }
}
