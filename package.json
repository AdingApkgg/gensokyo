{
  "name": "gensokyo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "services": "./scripts/dev-services.sh up",
    "services:status": "./scripts/dev-services.sh status",
    "services:down": "./scripts/dev-services.sh down",
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "turbo": "^2.10.12"
  }
}
